# Model: "provider:model" (langchain init_chat_model)
AGENT_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
# Or OpenAI / any OpenAI-compatible server (e.g. vLLM serving Bielik):
# AGENT_MODEL=openai:speakleash/Bielik-11B-v2.6-Instruct
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=dummy

TARGET_NAMESPACE=otel-demo
HELM_RELEASE=otel-demo
PROMETHEUS_URL=http://localhost:9090
OPENSEARCH_URL=http://localhost:9200
FLAGD_OFREP_URL=http://localhost:8016
FLAGD_UI_URL=http://localhost:8080/feature   # flag definitions incl. targeting rules

# AGENT_TEMPERATURE=0     # only for models that accept temperature
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TOOL_OUTPUT_CHARS=4000

# Language of the agent's text and the report: en | pl
# AGENT_LANGUAGE=en

# --- Webhook (incident-agent serve) ---
# WEBHOOK_TOKEN=change-me            # when set, POST /alertmanager requires an Authorization: Bearer <token> header
# DEDUP_WINDOW_MINUTES=30            # how long after its alerts resolve an incident absorbs echoes and flapping alerts

# --- State (step 5c) ---
# Checkpoints and the incident list. Default: a SQLite file. The in-cluster agent uses Postgres
# (set in deploy/k8s/agent.yaml, not here):
# CHECKPOINT_DB=.data/checkpoints.sqlite
# CHECKPOINT_DB=postgresql://agent:<password>@localhost:5432/agent

# --- Tracing (optional) ---
# LangSmith: environment variables only
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=k8s-incident-agent
# Langfuse: pip install -e ".[tracing]"
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
