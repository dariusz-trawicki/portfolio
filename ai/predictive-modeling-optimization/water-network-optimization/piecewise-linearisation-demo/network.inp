[TITLE]
Network A-B-C-T - demonstration model
Reservoir A supplies junctions B and C; open tank T balances the diurnal demand variation.
Flow units: CMH (m3/h).  Head loss: Hazen-Williams.

[JUNCTIONS]
;ID              Elev         Demand       Pattern
 B               85           40           DAILY                   ;demand junction B
 C               85           60           DAILY                   ;demand junction C

[RESERVOIRS]
;ID              Head         Pattern
 A               100                                               ;constant-head source

[TANKS]
;ID              Elev         InitLvl      MinLvl       MaxLvl       Diam         MinVol       VolCurve
 T               90           5            1            8            10           0                                    ;open tank

[PIPES]
;ID              Node1        Node2        Length       Diam         Rough        MinorLoss    Status
 p1              A            B            500          150          130          0            Open
 p2              B            C            400          125          130          0            Open
 p3              A            C            600          150          130          0            Open
 p4              C            T            300          125          130          0            Open

[PATTERNS]
;ID              Multipliers
;Diurnal demand pattern - hours 0..23
 DAILY           0.55         0.45         0.40         0.40         0.50         0.75
 DAILY           1.10         1.45         1.55         1.35         1.15         1.05
 DAILY           1.00         0.95         0.90         0.95         1.10         1.35
 DAILY           1.50         1.40         1.20         1.00         0.80         0.65

